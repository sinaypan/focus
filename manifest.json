{
  "manifest_version": 3,
  "name": "Focus",
  "version": "0.2.0",
  "description": "Des séances de travail par blocs : une tâche à la fois, des pauses fixes, l’onglet à part en plein écran et un minuteur qui suit sur chaque page.",
  "permissions": ["storage", "alarms", "notifications", "webNavigation", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
